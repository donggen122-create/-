{
  "name": "mom-brain-games",
  "version": "0.3.0",
  "private": true,
  "description": "엄마를 위한 명화 직소 퍼즐 (앱인토스 미니앱, 스테이지 1~200, 20~25조각)",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node tests/smoke.test.js",
    "build:web": "node tools/build-web.mjs",
    "build": "node tools/build-web.mjs && ait build",
    "deploy": "ait deploy",
    "deploy:web": "node tools/build-web.mjs && wrangler pages deploy --branch=main"
  },
  "devDependencies": {
    "canvas": "^3.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.5.0"
  }
}
